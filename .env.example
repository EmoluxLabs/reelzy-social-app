# Obsidian Circle — environment configuration
# Copy to .env and edit; the API loads .env from the repo root (apps/api/.env also works).

# Server
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://yourdomain.example

# Auth — change in production! Any non-empty value overrides the dev fallback.
JWT_SECRET=replace-with-long-random-string-at-least-32-bytes
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Obsidian Network RPC (chain-id 7777 mainnet). Leave unset for dev mode.
OBS_RPC_URL=https://your-obs-node.example:8630
OBS_TREASURY_ADDRESS=obs1...real-treasury-address-here
OBS_TREASURY_PRIVATE_KEY=
OBS_CHAIN_ID=7777
OBS_REQUIRED_CONFIRMATIONS=6

# Media
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=100

# Live streaming (optional; LiveKit SFU). When unset, rooms use peer mesh.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
GIFT_RATE_LIMIT_MAX=30
